// services/api.js
const HOST = 'http://localhost:3000';

// Общая функция для обработки fetch запросов
async function fetchWithErrorHandling(url, options = {}) {
    const response = await fetch(url, options);
    
    // Если статус успешный (2xx)
    if (response.ok) {
        // Если ответ пустой (204 No Content)
        if (response.status === 204) {
            return null;
        }
        return response.json();
    }
    
    // Если статус ошибки (4xx, 5xx)
    let errorData = {};
    try {
        errorData = await response.json();
    } catch (e) {
        // Если не удалось распарсить JSON, пробуем получить текст
        try {
            const text = await response.text();
            errorData = { message: text || `HTTP ${response.status}: ${response.statusText}` };
        } catch (e2) {
            errorData = { message: `HTTP ${response.status}: ${response.statusText}` };
        }
    }
    
    // Создаем объект ошибки с дополнительной информацией
    const error = new Error(errorData.message || errorData.error || `Ошибка ${response.status}`);
    error.response = {
        status: response.status,
        data: errorData
    };
    error.status = response.status;
    error.data = errorData;
    
    // Логируем для отладки
    console.error(`❌ API ошибка ${response.status}:`, errorData);
    
    throw error;
}

// GET запросы
export async function getProducts() {
    return fetchWithErrorHandling(`${HOST}/products`);
}

export async function getProduct(id) {
    return fetchWithErrorHandling(`${HOST}/products/${id}`);
}

// POST запросы
export async function register(data) {
    return fetchWithErrorHandling(`${HOST}/register`, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json'
        },
        body: JSON.stringify(data)
    });
}

export async function login(data) {
    return fetchWithErrorHandling(`${HOST}/login`, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json'
        },
        body: JSON.stringify(data)
    });
}

export async function logout() {
    return fetchWithErrorHandling(`${HOST}/logout`, {
        method: 'POST'
    });
}












